---
import BaseLayout from "../layouts/BaseLayout.astro";

const works = [
  {
    number: "01",
    type: "MOVIE / MUSIC VIDEO",
    title: "Music Video & Visual Edit",
    description: "歌ってみたMV、映像演出、リリック表現など。",
    tag: "AFTER EFFECTS",
    image: `${import.meta.env.BASE_URL}images/MixImage.png`,
    alt: "歌ってみたのMIX動画サンプル",
    url: "https://www.youtube.com/watch?v=7MN1Aabyc7g&list=PLPfFiSzCrNDI&pp=0gcJCR0Ga94AFGB0sAgC",
    className: "work-visual visual-one"
    
  },
  {
    number: "02",
    type: "DEVELOPMENT / TOOL",
    title: "TelopAssistant",
    description: "映像制作のワークフローを支える、自作ツールの企画・開発。",
    tag: "SCRIPT / PRODUCT",
    image: `${import.meta.env.BASE_URL}images/TelopAssistantImage.png`,
    alt: "TelopAssistantの紹介画像",
    url: "https://inuneko-vrcshop.booth.pm/items/9051072",
    className: "work-visual visual-two"
  },
  {
    number: "03",
    type: "3D / VIRTUAL CONTENT",
    title: "VRChat Creative Works",
    description: "アバター、ワールド、ギミックなどのバーチャルコンテンツ制作。",
    tag: "UNITY",
    image: `${import.meta.env.BASE_URL}images/VRCImage.png`,
    alt: "クロとシロのVRChatイラスト",
    url: "https://lit.link/inubukikuro",
    className: "work-visual visual-three"
  }
];
const categories = [
  ["01", "MOVIE", "映像制作・動画編集"],
  ["02", "MOTION", "モーショングラフィックス"],
  ["03", "DESIGN", "ロゴ・グラフィック"],
  ["04", "DEVELOPMENT", "ツール・スクリプト開発"],
  ["05", "VR / 3D", "VRChat・Unity関連"]
];
---
<BaseLayout title="CREATIVE PORTFOLIO ? Ideas into Reality" description="映像・デザイン・開発。あらゆる創作をまとめたクリエイターポートフォリオ。">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="トップへ">
      <span class="brand-mark">C.</span>
      <span class="brand-name">CREATIVE PORTFOLIO<small>INDEPENDENT CREATOR</small></span>
    </a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      <a href="#about">ABOUT</a>
      <a href="#works">WORKS</a>
      <a href="#services">SERVICES</a>
      <a href="#fields">FIELDS</a>
      <a href="#contact">CONTACT</a>
    </nav>
    <a class="header-cta" href="#contact">LET'S TALK <span>?</span></a>
    <button class="menu-toggle" aria-label="メニューを開く" aria-expanded="false">?</button>
  </header>

  <main id="top">
    <section class="hero section-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> PORTFOLIO / 2026</p>
        <h1>Ideas into<br /><span>Reality.</span></h1>
        <p class="hero-lead">映像・デザイン・開発。<br />アイデアを、かたちにする。</p>
        <p class="hero-description">ジャンルにとらわれず、表現と技術を横断して制作しています。<br class="desktop-only" />ここでは、これまでの作品と取り組みをご紹介します。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#works">VIEW WORKS <span>?</span></a>
          <a class="text-link" href="#about">ABOUT ME <span>?</span></a>
        </div>
      </div>
      <div class="hero-art" aria-label="抽象的な青い光のビジュアル">
        <div class="art-orbit orbit-a"></div>
        <div class="art-orbit orbit-b"></div>
        <div class="art-core"></div>
        <div class="art-cross cross-a"></div>
        <div class="art-cross cross-b"></div>
        <div class="art-caption">CREATIVE<br />IN PROGRESS<span>?</span></div>
        <div class="art-index">FIG. 001 ? DIGITAL EXPRESSION</div>
      </div>
      <div class="hero-bottom">
        <span>SCROLL TO EXPLORE</span>
        <span class="scroll-line"></span>
        <span>01 / 05</span>
      </div>
    </section>

    <section class="intro section-shell" id="about">
      <div class="section-label"><span>01</span> / ABOUT</div>
      <div class="intro-content">
        <p class="overline">A LITTLE INTRODUCTION</p>
        <h2>つくることを、<br /><span>ひとつの領域に閉じ込めない。</span></h2>
        <p class="body-copy">映像を編集する。デザインを組み立てる。ツールを開発する。<br />異なる分野の知識や技術を組み合わせながら、目的に合った表現を探しています。</p>
        <a class="arrow-link" href="#contact">MORE ABOUT ME <span>?</span></a>
      </div>
      <div class="intro-aside">
        <div class="aside-line"></div>
        <p>CREATIVE<br />× TECHNOLOGY<br />× STORYTELLING</p>
        <span>INDEPENDENT CREATOR</span>
      </div>
    </section>

    <section class="works section-shell" id="works">
      <div class="section-heading">
        <div>
          <div class="section-label"><span>02</span> / SELECTED WORKS</div>
          <h2>Selected <span>Works.</span></h2>
        </div>
        <p>制作物の一部をご紹介します。<br />各作品の詳細は、今後順次追加予定です。</p>
      </div>
      <div class="works-grid">
        {works.map((work) => (
          <a
	  class="work-card"
	  href={work.url}
	  target="_blank"
	  rel="noopener noreferrer"
	  aria-label={`${work.title} を開く`}
	>
		<div class={work.className}>
			<img
			  class="work-thumbnail"
			  src={work.image}
			  alt={work.alt}
			  title={work.title}
			  loading="lazy"
			/>
		  <span class="work-number">{work.number}</span>
		  
		  <div class="work-overlay">
		  <span class="work-overlay-title">{work.title}</span>
		  <span class="work-overlay-label">VIEW PROJECT ?</span>
		</div>
		</div>
            <div class="work-meta">{work.type}<span>{work.tag}</span></div>
            <h3>{work.title}</h3>
            <p>{work.description}</p>
            <span class="coming-soon">PROJECT DETAILS COMING SOON</span>
         </a>
        ))}
      </div>
    </section>

    <section class="services section-shell" id="services">
      <div class="section-heading">
        <div>
          <div class="section-label"><span>03</span> / SERVICES & SHOP</div>
          <h2>Services <span>& Shop.</span></h2>
        </div>
        <p>制作のご依頼や、オリジナルアイテムはこちらから。<br />外部サービスのページで詳細をご確認いただけます。</p>
      </div>

      <div class="services-grid">
        <article class="service-card">
          <div class="service-visual service-visual-mix">
            <span class="service-index">01 / VOCAL MIX</span>
            <span class="service-symbol">音</span>
            <span class="service-visual-caption">VOICE × MUSIC</span>
          </div>
          <div class="service-content">
            <p class="service-kicker">CREATIVE SERVICE</p>
            <h3>歌ってみた MIX</h3>
            <p>ボーカルを楽曲になじませ、作品の魅力を引き出すMIXサービス。ご依頼・サービス内容の詳細はココナラをご覧ください。</p>
            <a class="service-link" href="https://coconala.com/services/4030055" target="_blank" rel="noopener noreferrer">
              VIEW SERVICE <span>?</span>
            </a>
          </div>
        </article>

        <article class="service-card">
          <div class="service-visual service-visual-shop">
            <span class="service-index">02 / DIGITAL SHOP</span>
            <span class="service-symbol">創</span>
            <span class="service-visual-caption">VIRTUAL × CREATION</span>
          </div>
          <div class="service-content">
            <p class="service-kicker">ORIGINAL ITEMS</p>
            <h3>クロシロしょっぷ</h3>
            <p>VRChat向けアイテムを中心に、制作したデジタルコンテンツを販売しています。ショップはこちらからご覧いただけます。</p>
            <a class="service-link" href="https://inuneko-vrcshop.booth.pm/" target="_blank" rel="noopener noreferrer">
              VISIT SHOP <span>?</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="fields section-shell" id="fields">
      <div class="section-label"><span>04</span> / CREATIVE FIELDS</div>
      <div class="fields-heading">
        <h2>What I <span>Do.</span></h2>
        <p>複数の分野を横断しながら、<br />企画からアウトプットまで取り組みます。</p>
      </div>
      <div class="field-list">
        {categories.map(([num, name, desc]) => (
          <div class="field-row">
            <span class="field-num">{num}</span>
            <h3>{name}</h3>
            <p>{desc}</p>
            <span class="field-arrow">?</span>
          </div>
        ))}
      </div>
    </section>

    <section class="statement section-shell">
      <p class="overline">THE WAY I CREATE</p>
      <h2>Good ideas deserve<br /><span>good execution.</span></h2>
      <p>アイデアを思いつくだけで終わらせず、<br />伝わるかたちにするところまで。</p>
    </section>

    <section class="contact section-shell" id="contact">
      <div class="section-label"><span>05</span> / CONTACT</div>
      <div class="contact-inner">
        <p class="overline">HAVE A PROJECT IN MIND?</p>
        <h2>Let's make<br /><span>something.</span></h2>
        <p>制作のご相談・お仕事のご依頼など、<br />お気軽にご連絡ください。</p>
        <a class="button button-primary" href="mailto:inubukikurovr1024@gmail.com">GET IN TOUCH <span>?</span></a>
        <small>※公開前にメールアドレスを変更してください。</small>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href="#top"><span class="brand-mark">C.</span><span class="brand-name">CREATIVE PORTFOLIO<small>INDEPENDENT CREATOR</small></span></a>
    <span>c 2026 戌吹クロ. ALL RIGHTS RESERVED.</span>
    <a href="#top" class="back-top">BACK TO TOP ↑</a>
  </footer>

  <script>
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector(".desktop-nav");
    toggle?.addEventListener("click", () => {
      const opened = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!opened));
      nav?.classList.toggle("is-open", !opened);
    });
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }));
  </script>
</BaseLayout>

<style>

/* ========================================
   CREATIVE PORTFOLIO
   DARK NAVY / BLUE LIGHT
======================================== */

/* ---------- GLOBAL ---------- */

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
  background: #080d18;
}

:global(body) {
  margin: 0;
  background: #080d18;
  color: #eaf1fb;
  font-family: "Manrope", "Noto Sans JP", sans-serif;
  font-size: 14px;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

:global(a) {
  color: inherit;
}

:global(button) {
  font: inherit;
}

:global(img) {
  max-width: 100%;
}

:global(::selection) {
  background: rgba(105, 181, 255, 0.35);
  color: #fff;
}

/* ---------- COMMON ---------- */

.section-shell {
  width: min(1160px, calc(100% - 100px));
  margin-inline: auto;
}

section {
  position: relative;
}

.section-label {
  color: #8298b5;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.section-label span {
  color: #8fcaff;
}

.overline {
  color: #83bdf4;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.body-copy {
  color: #a7b5c8;
  font-size: 13px;
  line-height: 2.2;
}

.text-link,
.arrow-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #c4d8ef;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-decoration: none;
  transition: color 0.3s ease;
}

.text-link:hover,
.arrow-link:hover {
  color: #8bcaff;
}

.text-link span,
.arrow-link span {
  color: #83bdf4;
}

/* ========================================
   HEADER
======================================== */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 78px;
  padding: 0 max(50px, calc((100% - 1160px) / 2));
  background: rgba(8, 13, 24, 0.86);
  border-bottom: 1px solid rgba(150, 190, 235, 0.1);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #eaf3ff;
  text-decoration: none;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(125, 190, 255, 0.55);
  color: #a6d5ff;
  font-family: "DM Mono", monospace;
  font-size: 15px;
}

.brand-name {
  display: flex;
  flex-direction: column;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
  line-height: 1.5;
}

.brand-name small {
  color: #71849e;
  font-family: "DM Mono", monospace;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 0.16em;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 30px;
}

.desktop-nav a {
  position: relative;
  color: #a9b8ca;
  font-family: "DM Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.12em;
  text-decoration: none;
  transition: color 0.3s ease;
}

.desktop-nav a::after {
  position: absolute;
  right: 0;
  bottom: -7px;
  left: 0;
  height: 1px;
  background: #83c4ff;
  content: "";
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.3s ease;
}

.desktop-nav a:hover {
  color: #fff;
}

.desktop-nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.header-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border: 1px solid rgba(128, 190, 255, 0.45);
  color: #cce5ff;
  font-family: "DM Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-decoration: none;
  transition: background 0.3s ease, border-color 0.3s ease;
}

.header-cta:hover {
  background: rgba(90, 160, 230, 0.14);
  border-color: #8bcaff;
}

.header-cta span {
  color: #8bcaff;
}

.menu-toggle {
  display: none;
}

/* ========================================
   HERO
======================================== */

.hero {
  display: grid;
  grid-template-columns: 1fr 0.95fr;
  align-items: center;
  min-height: 690px;
  padding-top: 85px;
  padding-bottom: 115px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #8fa4bd;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.17em;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #79c5ff;
  box-shadow: 0 0 12px #5baaff;
}

.hero h1 {
  margin: 35px 0 25px;
  color: #f2f7ff;
  font-size: clamp(64px, 8vw, 104px);
  font-weight: 700;
  letter-spacing: -0.085em;
  line-height: 0.98;
}

.hero h1 span {
  color: #83c4ff;
  text-shadow: 0 0 35px rgba(80, 160, 255, 0.25);
}

.hero-lead {
  margin: 30px 0 16px;
  color: #dce9f8;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.9;
  letter-spacing: 0.04em;
}

.hero-description {
  color: #8799b0;
  font-size: 11px;
  line-height: 2.2;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 30px;
  margin-top: 38px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 25px;
  min-width: 175px;
  padding: 16px 22px;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.button:hover {
  transform: translateY(-3px);
}

.button-primary {
  background: linear-gradient(110deg, #72baff, #a5d8ff);
  color: #071323;
  box-shadow: 0 8px 30px rgba(80, 160, 255, 0.15);
}

.button-primary:hover {
  box-shadow: 0 12px 40px rgba(80, 160, 255, 0.3);
}

.button-primary span {
  font-size: 14px;
}

/* ---------- HERO VISUAL ---------- */

.hero-art {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 460px;
  isolation: isolate;
}

.hero-art::before {
  position: absolute;
  width: 80%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(36, 113, 204, 0.2),
    rgba(16, 52, 100, 0.08) 45%,
    transparent 72%
  );
  filter: blur(15px);
  content: "";
}

.art-orbit {
  position: absolute;
  width: 310px;
  height: 310px;
  border: 1px solid rgba(120, 185, 255, 0.22);
  border-radius: 50%;
}

.orbit-a {
  transform: rotate(-30deg) scaleX(1.45);
  box-shadow: 0 0 35px rgba(68, 150, 255, 0.08);
  animation: orbit-rotate 24s linear infinite;
}

.orbit-b {
  width: 235px;
  height: 235px;
  border-color: rgba(120, 185, 255, 0.4);
  transform: rotate(55deg) scaleX(1.5);
  animation: orbit-rotate 30s linear infinite reverse;
}

.art-core {
  position: relative;
  z-index: 1;
  width: 135px;
  aspect-ratio: 1;
  border: 1px solid rgba(172, 220, 255, 0.75);
  border-radius: 50%;
  background: radial-gradient(
    circle at 35% 30%,
    #c4e8ff 0%,
    #4b9ae7 12%,
    #17477e 38%,
    #09172d 70%
  );
  box-shadow:
    0 0 35px rgba(81, 166, 255, 0.45),
    0 0 100px rgba(53, 132, 225, 0.25),
    inset -15px -20px 35px rgba(0, 0, 0, 0.5);
  animation: core-float 5s ease-in-out infinite;
}

.art-cross {
  position: absolute;
  z-index: 2;
  width: 10px;
  height: 10px;
  border: 1px solid #a9d8ff;
  transform: rotate(45deg);
  box-shadow: 0 0 15px rgba(130, 195, 255, 0.6);
}

.cross-a {
  top: 22%;
  right: 23%;
}

.cross-b {
  bottom: 23%;
  left: 22%;
  width: 6px;
  height: 6px;
}

.art-caption {
  position: absolute;
  right: 2%;
  bottom: 12%;
  color: #b9d6f4;
  font-family: "DM Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.17em;
  line-height: 2;
}

.art-caption span {
  color: #83c4ff;
}

.art-index {
  position: absolute;
  top: 9%;
  left: 2%;
  color: #627994;
  font-family: "DM Mono", monospace;
  font-size: 8px;
  letter-spacing: 0.14em;
}

.hero-bottom {
  position: absolute;
  right: 0;
  bottom: 35px;
  left: 0;
  display: flex;
  align-items: center;
  gap: 18px;
  color: #7488a2;
  font-family: "DM Mono", monospace;
  font-size: 8px;
  letter-spacing: 0.16em;
}

.scroll-line {
  width: 65px;
  height: 1px;
  background: linear-gradient(90deg, #80bfff, transparent);
}

/* ========================================
   ABOUT / INTRO
======================================== */

.intro {
  display: grid;
  grid-template-columns: 0.7fr 2fr 0.8fr;
  gap: 45px;
  align-items: start;
  padding-top: 125px;
  padding-bottom: 145px;
  border-top: 1px solid rgba(140, 180, 225, 0.13);
}

.intro-content {
  max-width: 650px;
}

.intro-content h2 {
  margin: 22px 0 30px;
  color: #f0f6ff;
  font-size: clamp(28px, 3.6vw, 43px);
  font-weight: 600;
  letter-spacing: -0.06em;
  line-height: 1.65;
}

.intro-content h2 span {
  color: #90caff;
}

.intro-content .body-copy {
  margin-bottom: 30px;
}

.intro-aside {
  padding-top: 40px;
}

.aside-line {
  width: 40px;
  height: 1px;
  margin-bottom: 20px;
  background: #80bfff;
}

.intro-aside p {
  color: #a4b8d0;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.13em;
  line-height: 2.5;
}

.intro-aside span {
  display: block;
  margin-top: 35px;
  color: #60758e;
  font-family: "DM Mono", monospace;
  font-size: 8px;
  letter-spacing: 0.12em;
}

/* ========================================
   SELECTED WORKS
======================================== */

.works {
  padding-top: 120px;
  padding-bottom: 145px;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(31, 77, 130, 0.15), transparent 55%),
    #0c1422;
  border-top: 1px solid rgba(140, 180, 225, 0.1);
  border-bottom: 1px solid rgba(140, 180, 225, 0.1);
}

.section-heading {
